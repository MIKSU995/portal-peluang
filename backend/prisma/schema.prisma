datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

enum OpportunityCategory {
  MAGANG
  BEASISWA
  LOMBA
  KOMPETISI
  MBKM
}

enum OpportunityStatus {
  ACTIVE
  EXPIRED
  ARCHIVED
}

model User {
  id           String            @id @default(uuid())
  email        String            @unique
  passwordHash String
  name         String
  role         String            @default("STUDENT")
  majorId      String?
  university   String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  major        Major?            @relation(fields: [majorId], references: [id])
  bookmarks    Bookmark[]
  applications UserApplication[]
}

model Major {
  id                String             @id @default(uuid())
  name              String             @unique
  code              String?
  category          String?
  users             User[]
  opportunityMajors OpportunityMajor[]
}

model OpportunityMajor {
  id            String      @id @default(uuid())
  opportunityId String
  majorId       String

  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  major         Major       @relation(fields: [majorId], references: [id], onDelete: Cascade)

  @@unique([opportunityId, majorId])
}

model Opportunity {
  id             String              @id @default(uuid())
  slug           String              @unique
  title          String
  organizer      String
  category       OpportunityCategory @default(MAGANG)
  status         OpportunityStatus   @default(ACTIVE)
  isOfficial     Boolean             @default(true)
  isVerified     Boolean             @default(true)
  reward         String?
  stipendOrPrize String?
  description    String
  location       String?
  requirements   String
  deadline       DateTime
  link           String              @default("")
  sourceUrl      String?
  sourceDomain   String?
  contentHash    String?             @unique
  viewsCount     Int                 @default(0)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  majors         OpportunityMajor[]
  bookmarks      Bookmark[]
  applications   UserApplication[]
  teamPosts      TeamPost[]
}

model Bookmark {
  id                  String      @id @default(uuid())
  userId              String
  opportunityId       String
  hasNotifiedDeadline Boolean     @default(false)
  createdAt           DateTime    @default(now())

  user                User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  opportunity         Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@unique([userId, opportunityId])
}

model UserApplication {
  id            String      @id @default(uuid())
  userId        String      @default("user-demo")
  opportunityId String
  status        String
  notes         String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  user          User?       @relation(fields: [userId], references: [id], onDelete: Cascade)
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@unique([userId, opportunityId])
}

model TeamPost {
  id             String      @id @default(uuid())
  opportunityId  String
  leaderName     String
  leaderMajor    String
  neededRoles    String
  description    String
  contactChannel String
  contactValue   String
  createdAt      DateTime    @default(now())

  opportunity    Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
}

model Notification {
  id            String   @id @default(uuid())
  userId        String   @default("user-demo")
  type          String   @default("INFO")
  title         String
  message       String
  opportunityId String?
  linkUrl       String?
  isRead        Boolean  @default(false)
  createdAt     DateTime @default(now())
}