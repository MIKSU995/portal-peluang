FROM node:18-alpine

WORKDIR /app

# Pasang OpenSSL yang dibutuhkan Prisma Engine pada Alpine
RUN apk add --no-cache openssl

# Copy file konfirmasi dependency & schema prisma
COPY package*.json ./
COPY prisma ./prisma/

# Install dependencies
RUN npm ci

# Copy sisa source code
COPY . .

# Generate Prisma Client & Build TypeScript
RUN npx prisma generate
RUN npm run build

EXPOSE 5000

CMD ["sh", "-c", "npx prisma migrate deploy && npm start"]